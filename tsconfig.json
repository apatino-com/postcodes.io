{
  "compilerOptions": {
    "module": "nodenext",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "target": "es2015",
    "lib": ["DOM", "es6"],
    "noImplicitAny": true,
    "moduleResolution": "nodenext",
    "allowJs": true,
    "sourceMap": false,
    "outDir": "dist",
    "rootDir": "api",
    "noEmit": false,
    "skipLibCheck": true
  },
  "include": ["api/**/*"],
  "exclude": ["node_modules/@types/mdx", "node_modules/@docusaurus"]
}
